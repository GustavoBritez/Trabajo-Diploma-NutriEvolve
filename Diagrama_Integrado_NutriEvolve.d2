# ============================================================
# Diagrama de Clases Integrado G06.1 - NutriEvolve (D2LANG)
# ============================================================

direction: right

# ------------------------------------------------------------
# MÓDULO PN1: TURNERO NUTRICIONAL
# ------------------------------------------------------------
pn1: "Módulo PN1: Turnero Nutricional" {
  style.fill: "#f4f9f4"
  style.stroke: "#2d6a4f"

  Tutor: {
    shape: class
    -idTutor: int
    -dniTutor: string
    -nombre: string
    -telefono: string
    -email: string
  }

  Paciente: {
    shape: class
    -idPaciente: int
    -dniNiño: string
    -nombre: string
    -fechaNacimiento: DateTime
    -sexo: string
    +obtenerEdadMeses(): int
  }

  AgendaMedica: {
    shape: class
    -idAgenda: int
    -fecha: DateTime
    +consultarDisponibilidad(): "List<BloqueHorario>"
  }

  BloqueHorario: {
    shape: class
    -horaInicio: TimeSpan
    -horaFin: TimeSpan
    -estadoBloque: string
    +marcarOcupado(): void
    +liberarBloque(): void
  }

  Turno: {
    shape: class
    icon: https://icons.terrastruct.com/essentials%2F008-calendar.svg
    label: "Turno <<Context-State>>"
    -idTurno: int
    -codigoTurno: string
    -fechaTurno: DateTime
    -horaTurno: TimeSpan
    +cambiarEstado(nuevoEstado: IEstadoTurno): void
    +confirmarTurno(): void
    +reprogramarTurno(): void
    +cancelarTurno(): void
    +registrarAsistencia(): void
  }

  IEstadoTurno: {
    shape: class
    label: "IEstadoTurno <<Interface State>>"
    +atender(turno: Turno): void
    +cancelar(turno: Turno): void
  }

  TurnoSolicitadoState: {
    shape: class
    label: "TurnoSolicitadoState <<ConcreteState>>"
  }
  TurnoConfirmadoState: {
    shape: class
    label: "TurnoConfirmadoState <<ConcreteState>>"
  }
  TurnoAsistioState: {
    shape: class
    label: "TurnoAsistioState <<ConcreteState>>"
  }
  TurnoCanceladoState: {
    shape: class
    label: "TurnoCanceladoState <<ConcreteState>>"
  }

  Nutricionista: {
    shape: class
    -idNutricionista: int
    -legajo: string
    -matricula: string
    -nombre: string
  }

  Recepcionista: {
    shape: class
    -idRecepcionista: int
    -nombre: string
  }
}

# ------------------------------------------------------------
# MÓDULO PN2: SEGUIMIENTO NUTRICIONAL PEDIÁTRICO
# ------------------------------------------------------------
pn2: "Módulo PN2: Seguimiento Nutricional Pediátrico" {
  style.fill: "#eef2f7"
  style.stroke: "#1d3557"

  ConsultaNutricional: {
    shape: class
    label: "ConsultaNutricional <<Subject-Observer>>"
    -idConsulta: int
    -fechaControl: DateTime
    -edadMeses: int
    -tipoLactancia: string
    +registrarMedicion(m: MedicionAntropometrica)
    +evaluarNutricion()
    +notificarAlertas()
  }

  MedicionAntropometrica: {
    shape: class
    -pesoKg: double
    -tallaCm: double
    -perimetroCefalicoCm: double
    +calcularIMC(): double
  }

  IEstrategiaCalculoOMS: {
    shape: class
    label: "IEstrategiaCalculoOMS <<Interface Strategy>>"
    +calcularZScores(m: MedicionAntropometrica, sexo: string): ZScoreResultado
  }

  CalculoOMS_Lactantes: {
    shape: class
    label: "CalculoOMS_Lactantes <<ConcreteStrategy>>"
  }
  CalculoOMS_Preescolares: {
    shape: class
    label: "CalculoOMS_Preescolares <<ConcreteStrategy>>"
  }
  CalculoOMS_Escolares: {
    shape: class
    label: "CalculoOMS_Escolares <<ConcreteStrategy>>"
  }

  ZScoreResultado: {
    shape: class
    -zPesoEdad: double
    -zTallaEdad: double
    -zIMCEdad: double
    -percentilIMC: double
  }

  IObservadorAlerta: {
    shape: class
    label: "IObservadorAlerta <<Interface Observer>>"
    +actualizarAlerta(alerta: string, severidad: string)
  }

  AlertaClinicaVisual: {
    shape: class
    label: "AlertaClinicaVisual <<ConcreteObserver>>"
    +dispararPopUpVisual()
  }

  DiagnosticoNutricional: {
    shape: class
    -clasificacionOMS: string
    -detalles: string
  }

  PlanAlimentario: {
    shape: class
    -kcalTotales: double
    -pautasFamiliares: string
  }
}

# ------------------------------------------------------------
# RELACIONES PN1
# ------------------------------------------------------------
pn1.Tutor -> pn1.Paciente: "1 -- 1..* (tutor de)"
pn1.Paciente -> pn1.Turno: "1 -- 0..* (solicita)"
pn1.Nutricionista -> pn1.AgendaMedica: "1 -- 1 (administra)"
pn1.AgendaMedica -> pn1.BloqueHorario: "1 *-- 1..* (compuesta por)"
pn1.BloqueHorario -> pn1.Turno: "1 -- 0..1 (asignado a)"
pn1.Recepcionista -> pn1.Turno: "1 ..> (gestiona)"
pn1.Nutricionista -> pn1.Turno: "1 ..> (atiende)"

# PATRÓN STATE
pn1.Turno -> pn1.IEstadoTurno: "1 o-- 1 (estadoActual)"
pn1.IEstadoTurno <- pn1.TurnoSolicitadoState: "implements"
pn1.IEstadoTurno <- pn1.TurnoConfirmadoState: "implements"
pn1.IEstadoTurno <- pn1.TurnoAsistioState: "implements"
pn1.IEstadoTurno <- pn1.TurnoCanceladoState: "implements"

# ------------------------------------------------------------
# INTEGRACIÓN PN1 -> PN2
# ------------------------------------------------------------
pn1.Turno -> pn2.ConsultaNutricional: "0..1 -- 0..1 (da origen a)"
pn1.Nutricionista -> pn2.ConsultaNutricional: "1 -- 0..* (realiza)"
pn1.Paciente -> pn2.ConsultaNutricional: "1 -- 0..* (historial clínico)"

# ------------------------------------------------------------
# RELACIONES PN2
# ------------------------------------------------------------
pn2.ConsultaNutricional -> pn2.MedicionAntropometrica: "1 *-- 1 (registra)"
pn2.ConsultaNutricional -> pn2.DiagnosticoNutricional: "1 *-- 1 (emite)"
pn2.ConsultaNutricional -> pn2.PlanAlimentario: "1 *-- 1 (prescribe)"

# PATRÓN STRATEGY
pn2.ConsultaNutricional -> pn2.IEstrategiaCalculoOMS: "1 o-- 1 (aplica Strategy)"
pn2.IEstrategiaCalculoOMS <- pn2.CalculoOMS_Lactantes: "implements"
pn2.IEstrategiaCalculoOMS <- pn2.CalculoOMS_Preescolares: "implements"
pn2.IEstrategiaCalculoOMS <- pn2.CalculoOMS_Escolares: "implements"
pn2.IEstrategiaCalculoOMS -> pn2.ZScoreResultado: "produce"

# PATRÓN OBSERVER
pn2.ConsultaNutricional -> pn2.IObservadorAlerta: "1 o-- 0..* (notifica Observer)"
pn2.IObservadorAlerta <- pn2.AlertaClinicaVisual: "implements"
